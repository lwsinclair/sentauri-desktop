{
  "mcpServers": {
    "sentauri-tools": {
      "command": "node",
      "args": ["mcp-server/server.js"],
      "env": {},
      "description": "Built-in Sentauri MCP tools for file operations, database, and HTTP requests",
      "autoStart": true
    },
    "web-fetch": {
      "command": "npx",
      "args": ["-y", "@mcp-server/web"],
      "env": {},
      "description": "Web content fetching and analysis",
      "autoStart": false
    },
    "filesystem": {
      "command": "npx", 
      "args": ["-y", "@mcp-server/filesystem"],
      "env": {},
      "description": "Safe filesystem operations",
      "autoStart": false
    },
    "git": {
      "command": "node",
      "args": ["mcp-servers/git-server.js"],
      "env": {},
      "description": "Git repository operations and version control",
      "autoStart": false
    },
    "email": {
      "command": "node",
      "args": ["mcp-servers/email-server.js"],
      "env": {
        "SMTP_HOST": "smtp.gmail.com",
        "SMTP_PORT": "587"
      },
      "description": "Email sending and management capabilities",
      "autoStart": false
    },
    "calculator": {
      "command": "node",
      "args": ["mcp-servers/calculator-server.js"],
      "env": {},
      "description": "Advanced mathematical calculations and expression evaluation",
      "autoStart": false
    },
    "weather": {
      "command": "npx",
      "args": ["-y", "@mcp-server/weather"],
      "env": {},
      "description": "Weather information and forecasts",
      "autoStart": false
    },
    "search": {
      "command": "npx",
      "args": ["-y", "@mcp-server/search"],
      "env": {},
      "description": "Web search capabilities",
      "autoStart": false
    }
  },
  "security": {
    "allowedPaths": ["${HOME}"],
    "deniedPaths": ["/etc", "/sys", "/proc"],
    "maxRequestTimeout": 30000,
    "enableLogging": true
  }
}